# AWS Configuration for AeroTwin (S3 + CloudFront CDN)
# Copy this file to .env or export these variables in your shell environment

# AWS Credentials & S3 Bucket Settings
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_REGION=us-east-1
S3_BUCKET_NAME=aerotwin-static-assets

# CloudFront CDN Distribution Domain (without https://)
CLOUDFRONT_DOMAIN=d123456abcdef.cloudfront.net

# Frontend Vite environment variable (set in frontend/.env)
VITE_CLOUDFRONT_URL=https://d123456abcdef.cloudfront.net
